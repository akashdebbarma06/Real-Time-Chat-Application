<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Strictly enforce HTTPS: cleartext HTTP is prohibited in production APK -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
